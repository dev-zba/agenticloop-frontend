# Spec Detective — Frontend environment
# Copy to .env and adjust for local development.
# .env is gitignored — do not commit secrets here.

# Backend API base URL.
# `/api` (default) uses the Next.js rewrite proxy to http://127.0.0.1:8000 (see next.config.ts).
# Set a full URL only if the backend runs on a different host or port.
NEXT_PUBLIC_API_URL=/api
